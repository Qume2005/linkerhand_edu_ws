<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>l10_right_hand_bootstrap</name>
  <version>0.0.1</version>
  <description>Launch files for L10 right hand (sim / real hardware)</description>
  <maintainer email="larkume@todo.todo">larkume</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>

  <exec_depend>l10_right_hand_mujoco_sim</exec_depend>
  <exec_depend>l10_right_hand_driver</exec_depend>
  <exec_depend>l10_hand_gateway</exec_depend>
  <exec_depend>l10_hand_control_panel</exec_depend>
  <exec_depend>l10_right_hand_viz</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
